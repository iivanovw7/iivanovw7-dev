{
	"name": "iivanovw7-dev",
	"version": "1.0.0",
	"description": "Personal website",
	"type": "module",
	"scripts": {
		"dev": "cargo watch -x run",
		"dev:css": "rspack --watch",
		"build": "pnpm build:css && pnpm build:server",
		"build:server": "cargo build --release",
		"build:css": "rspack build",
		"build:run": "cargo run",
		"cypress:open": "cypress open",
		"cypress:run": "cypress run",
		"test": "pnpm run /^test:/",
		"test:e2e": "node e2e/runner.mjs",
		"test:server": "cargo test",
		"test:format:fmt": "cargo fmt -- --check",
		"test:format:eslint": "eslint \"**/*.{js,jsx}\"",
		"test:format:prettier": "prettier --write --ignore-unknown .",
		"test:format:djlint": "djlint templates/**/*.tera --reformat --format-js",
		"test:format:stylelint": "stylelint \"styles/**/*.{css,scss}\"",
		"prepare": "husky"
	},
	"keywords": [],
	"author": "iivanovw7",
	"license": "ISC",
	"dependencies": {
		"@alpinejs/morph": "3.13.5",
		"alpinejs": "3.13.5",
		"gsap": "3.12.5",
		"htmx-ext-class-tools": "2.0.2",
		"htmx.org": "1.9.10"
	},
	"devDependencies": {
		"@commitlint/cli": "19.5.0",
		"@commitlint/config-conventional": "19.5.0",
		"@cypress/code-coverage": "3.14.5",
		"@rspack/cli": "1.3.5",
		"@rspack/core": "1.3.5",
		"autoprefixer": "10.4.17",
		"chromedriver": "138.0.2",
		"clean-webpack-plugin": "4.0.0",
		"css-loader": "7.1.2",
		"cypress": "14.5.2",
		"cz-conventional-changelog": "^3.3.0",
		"eslint": "9.13.0",
		"eslint-plugin-import": "2.31.0",
		"eslint-plugin-jsdoc": "50.4.3",
		"eslint-plugin-n": "17.11.1",
		"eslint-plugin-node-import": "1.0.4",
		"eslint-plugin-perfectionist": "3.9.1",
		"eslint-plugin-prefer-arrow": "1.2.3",
		"eslint-plugin-prefer-let": "4.0.0",
		"eslint-plugin-promise": "7.1.0",
		"eslint-plugin-sonarjs": "2.0.4",
		"eslint-plugin-unicorn": "56.0.0",
		"globals": "16.3.0",
		"husky": "9.1.6",
		"npm-run-all": "4.1.5",
		"postcss": "8.4.47",
		"postcss-100vh-fix": "1.0.2",
		"postcss-dark-theme-class": "1.3.0",
		"postcss-loader": "8.1.1",
		"postcss-preset-env": "10.0.5",
		"prettier": "3.2.5",
		"rimraf": "6.0.1",
		"rspack-manifest-plugin": "5.0.3",
		"sass": "1.79.4",
		"sass-embedded": "1.86.3",
		"sass-loader": "16.0.5",
		"stylelint": "16.17.0",
		"stylelint-config-recess-order": "6.0.0",
		"stylelint-config-recommended-scss": "14.1.0",
		"stylelint-config-sass-guidelines": "12.1.0",
		"stylelint-order": "6.0.4",
		"stylelint-scss": "6.8.1",
		"wait-on": "8.0.3"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	}
}
