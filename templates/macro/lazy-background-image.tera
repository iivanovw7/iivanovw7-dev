{% macro lazy_background_image(id, img_url, container_class="", alt_text="") %}
    {% set container_classes = "lazy-background-image__container" ~ " " ~ container_class | trim %}
    <div id="lazy-background-image-container-{{ id }}"
         class="{{ container_classes }}"
         style="overflow: hidden"
         x-data="lazyBackgroundImage('{{ img_url }}')">
        <div x-show="isLoading" class="lazy-background-image__placeholder">{{ alt_text }}</div>
        <div x-show="isError" class="lazy-background-image__error">Failed to load image.</div>
        <div x-show="!isLoading"
             :style="`background-image: url('${imageUrl}');`"
             class="lazy-background-image"></div>
    </div>
    <script>
        document.addEventListener("alpine:init", () => {
            Alpine.data("lazyBackgroundImage", (initialImageUrl) => ({
                isLoading: true,
                isError: false,
                imageUrl: null,

                init() {
                    if (!initialImageUrl) {
                        this.isError = true;
                        this.isLoading = false;

                        console.error("Lazy background image: URL is empty or invalid.");

                        return;
                    }

                    let observer = new IntersectionObserver(
                        (entries) => {
                            for (const entry of entries) {
                                if (entry.isIntersecting) {
                                    const img = new Image();

                                    img.onload = () => {
                                        this.isLoading = false;
                                        this.imageUrl = initialImageUrl;
                                    };

                                    img.onerror = () => {
                                        this.isLoading = false;
                                        this.isError = true;
                                        console.error(`Failed to load image: ${initialImageUrl}`);
                                    };

                                    img.src = initialImageUrl;

                                    observer.unobserve(entry.target);
                                }
                            }
                        }, {
                            rootMargin: "0px 0px 50px 0px"
                        },
                    );

                    observer.observe(this.$el);
                },
            }));
        });
    </script>
{% endmacro lazy_background_image %}
