<canvas class="home-particles" id="particle-canvas"></canvas>
<script>
(() => {
    const initParticles = () => {
        let canvas = document.getElementById("particle-canvas");

        if (!canvas) return;

		let particleColor = "";

		const updateParticleColor = () => {
			particleColor = getComputedStyle(document.documentElement)
				.getPropertyValue("--particles-base-color")
				.trim();
		};

		updateParticleColor();

		const themeObserver = new MutationObserver(() => {
			updateParticleColor();
		});

		themeObserver.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class", "data-theme"]
		});

        let ctx = canvas.getContext("2d", { alpha: true, desynchronized: true });

        let config = {
            desktopParticles: 150,
            mobileParticles: 100,
            connectDist: 130,
            mouseRadius: 160,
            magnetForce: 0.08,
            returnForce: 0.05,
            maxDpr: 2
        };

        let width = 0, height = 0, particles = [];
        let mouse = {
			x: -1000,
			y: -1000,
			active: false
		};
        let grid = new Map();

        const getParticleCount = () => {
			return window.innerWidth <= 768 ? config.mobileParticles : config.desktopParticles;
		};

        const resizeCanvas = () => {
            let dpr = Math.min(window.devicePixelRatio || 1, config.maxDpr);
            width = window.innerWidth;
            height = window.innerHeight;

            canvas.style.width = `${width}px`;
            canvas.style.height = `${height}px`;
            canvas.width = Math.floor(width * dpr);
            canvas.height = Math.floor(height * dpr);
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        };

        class Particle {
            constructor() {
                this.x = this.baseX = Math.random() * width;
                this.y = this.baseY = Math.random() * height;
                this.radius = Math.random() * 2 + 1.5;

                this.offsetX = Math.random() * Math.PI * 2;
                this.offsetY = Math.random() * Math.PI * 2;
                this.speed = 0.00015 + Math.random() * 0.0002;
                this.amp = 100 + Math.random() * 100;

                this.alphaBase = Math.random() * 0.6 + 0.3;
                this.alphaOffset = Math.random() * Math.PI * 2;
                this.alphaSpeed = 0.0005 + Math.random() * 0.001;
                this.alpha = this.alphaBase;
            }

            update(time) {
                let targetX = this.baseX + Math.sin(time * this.speed + this.offsetX) * this.amp;
                let targetY = this.baseY + Math.cos(time * this.speed + this.offsetY) * this.amp;
                let tx = targetX, ty = targetY;

                if (mouse.active) {
                    let dx = mouse.x - targetX, dy = mouse.y - targetY;

                    if (dx * dx + dy * dy < config.mouseRadius ** 2) {
                        tx += dx * 0.5;
                        ty += dy * 0.5;
                    }
                }

                let force = mouse.active ? config.magnetForce : config.returnForce;

                this.x += (tx - this.x) * force;
                this.y += (ty - this.y) * force;
                this.alpha = Math.min(1, Math.max(0.1, this.alphaBase + Math.sin(time * this.alphaSpeed + this.alphaOffset) * 0.25));
            }

            draw() {
                ctx.globalAlpha = this.alpha;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        const createParticles = () => {
            particles = Array.from({ length: getParticleCount() }, () => new Particle());
        };

        const rebuildGrid = () => {
            grid.clear();

            for (let p of particles) {
                let key = `${Math.floor(p.x / config.connectDist)},${Math.floor(p.y / config.connectDist)}`;

                if (!grid.has(key)) {
					grid.set(key, []);
				};

                grid.get(key).push(p);
            }
        };

        const drawConnections = () => {
            let maxDistSq = config.connectDist ** 2;

            ctx.lineWidth = 1;
            ctx.strokeStyle = particleColor;

            for (let [key, cell] of grid) {
                let [gx, gy] = key.split(",").map(Number);

                for (let ox = -1; ox <= 1; ox++) {
                    for (let oy = -1; oy <= 1; oy++) {
                        let neighbor = grid.get(`${gx + ox},${gy + oy}`);

                        if (!neighbor) continue;

                        for (let a of cell) {
                            for (let b of neighbor) {
                                if (a === b) continue;

                                let dx = a.x - b.x, dy = a.y - b.y;
                                let distSq = dx * dx + dy * dy;

                                if (distSq < maxDistSq) {
                                    ctx.globalAlpha = (1 - Math.sqrt(distSq) / config.connectDist) * 0.35;
                                    ctx.beginPath();
                                    ctx.moveTo(a.x, a.y);
                                    ctx.lineTo(b.x, b.y);
                                    ctx.stroke();
                                }
                            }
                        }
                    }
                }
            }
        };

        const render = () => {
            let time = performance.now() * 0.3;

            ctx.clearRect(0, 0, width, height);
			ctx.fillStyle = particleColor;

            for (let p of particles) {
				p.update(time);
			};

            rebuildGrid();

            for (let p of particles) {
				p.draw();
			};

            drawConnections();

            ctx.globalAlpha = 1;
        };

        let resizeTimeout;

        const handleResize = () => {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(() => {
                let prevW = width, prevH = height;

                resizeCanvas();

                if (prevW > 0 && prevH > 0) {
                    let sx = width / prevW, sy = height / prevH;

                    for (let p of particles) {
                        p.x *= sx; p.y *= sy;
                        p.baseX *= sx; p.baseY *= sy;
                    }
                }

                if (particles.length !== getParticleCount()) {
					createParticles();
				};
            }, 150);
        };

        resizeCanvas();
        createParticles();

        window.addEventListener("mousemove", e => {
			mouse.x = e.clientX;
			mouse.y = e.clientY;
			mouse.active = true;
		}, { passive: true });

        window.addEventListener("mouseleave", () => {
			mouse.active = false;
		}, { passive: true });

        window.addEventListener("resize", handleResize, { passive: true });

        if (window.gsap) {
            gsap.ticker.add(render);
        } else {
            const loop = () => {
				render();
				requestAnimationFrame(loop);
			};

            requestAnimationFrame(loop);
        }
    };

    if (window.Alpine) {
        initParticles();
    } else {
        document.addEventListener("alpine:init", initParticles);
    }
})();
</script>
